#!/bin/sh

op="$1"; shift

echo "extern crate $op;"
echo 'use std::os::raw::c_int;'
echo ''
for lib in "$@"
do
  echo '#[link(name="'"$lib"'")]'
done
echo 'extern "C" {'
echo '  fn c_main() -> c_int;'
echo '}'
echo ''
echo 'fn main() {'
echo '  unsafe {'
echo '    std::process::exit(c_main())'
echo '  }'
echo '}'
echo ''
